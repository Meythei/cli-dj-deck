Screen {
    background: $surface;
}

#root {
    height: 100%;
}

#library-pane {
    width: 52;
    border: round $primary;
    border-title-align: center;
    border-title-color: $primary;
}

#library-tabs {
    height: 1fr;
}

#tracks-table,
#snips-table {
    height: 1fr;
}

#right-pane {
    width: 1fr;
}

#console-pane {
    height: 1fr;
    border: round $primary;
    border-title-align: center;
    border-title-color: $primary;
}

#console-log {
    height: 1fr;
}

#queue-view {
    height: auto;
    max-height: 7;
    border-top: solid $primary;
    padding: 0 1;
}

#command-input {
    dock: bottom;
    border: none;
    border-top: solid $primary;
}

#lanes-view {
    height: 1fr;
    border: round $accent;
    border-title-align: center;
    border-title-color: $accent;
    padding: 0 1;
}
